generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
}

model Student {
  id            String        @id @default(uuid())
  admissionNo   String        @unique
  firstName     String
  lastName      String
  email         String?       @unique
  phone         String?
  gender        StudentGender
  dateOfBirth   DateTime?
  className     String
  section       String?
  guardianName  String
  guardianPhone String
  address       String?
  status        StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("students")
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum ParentStatus {
  ACTIVE
  INACTIVE
}

model Parent {
  id         String         @id @default(uuid())
  fullName   String
  email      String?        @unique
  phone      String
  relation   ParentRelation
  occupation String?
  address    String?
  status     ParentStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parents")
}

enum GuardianRelation {
  UNCLE
  AUNT
  GRANDFATHER
  GRANDMOTHER
  BROTHER
  SISTER
  OTHER
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

model Guardian {
  id         String           @id @default(uuid())
  fullName   String
  email      String?          @unique
  phone      String
  relation   GuardianRelation
  occupation String?
  address    String?
  status     GuardianStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guardians")
}

enum TeacherGender {
  MALE
  FEMALE
  OTHER
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

model Teacher {
  id            String        @id @default(uuid())
  employeeNo    String        @unique
  fullName      String
  email         String        @unique
  phone         String
  gender        TeacherGender
  subject       String
  qualification String?
  joiningDate   DateTime
  address       String?
  status        TeacherStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teachers")
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

model SchoolClass {
  id           String      @id @default(uuid())
  className    String
  section      String
  classTeacher String?
  roomNo       String?
  capacity     Int?
  status       ClassStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([className, section])
  @@map("classes")
}

enum ClassRoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model ClassRoom {
  id       String          @id @default(uuid())
  roomNo   String          @unique
  roomName String
  building String?
  floor    String?
  capacity Int?
  status   ClassRoomStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("class_rooms")
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

model Subject {
  id          String        @id @default(uuid())
  subjectCode String        @unique
  subjectName String
  className   String?
  teacherName String?
  weeklyHours Int?
  status      SubjectStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

enum ClassRoutineStatus {
  ACTIVE
  INACTIVE
}

enum RoutineDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ClassRoutine {
  id          String             @id @default(uuid())
  routineCode String             @unique
  className   String
  section     String
  subjectName String
  teacherName String
  roomNo      String
  day         RoutineDay
  startTime   String
  endTime     String
  status      ClassRoutineStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("class_routines")
}

enum ExamStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Exam {
  id          String     @id @default(uuid())
  examCode    String     @unique
  examName    String
  className   String
  section     String
  subjectName String
  teacherName String
  roomNo      String
  examDate    DateTime
  startTime   String
  endTime     String
  maxMarks    Int
  minMarks    Int
  status      ExamStatus @default(SCHEDULED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("exams")
}

enum GradeResult {
  PASS
  FAIL
}

enum GradeStatus {
  DRAFT
  PUBLISHED
}

model Grade {
  id            String      @id @default(uuid())
  gradeCode     String      @unique
  examCode      String
  examName      String
  className     String
  section       String
  subjectName   String
  teacherName   String
  admissionNo   String
  studentName   String
  marksObtained Int
  maxMarks      Int
  minMarks      Int
  result        GradeResult
  gradeLetter   String
  status        GradeStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examCode, admissionNo])
  @@map("grades")
}

enum SyllabusSubjectGroupStatus {
  ACTIVE
  INACTIVE
}

model SyllabusSubjectGroup {
  id            String                     @id @default(uuid())
  groupCode     String                     @unique
  groupName     String
  className     String
  section       String
  classTeacher  String?
  subjectNames  String[]
  subjectCodes  String[]                   @default([])
  totalSubjects Int                        @default(0)
  status        SyllabusSubjectGroupStatus @default(ACTIVE)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@map("syllabus_subject_groups")
}

enum TimeTableStatus {
  ACTIVE
  INACTIVE
}

model TimeTable {
  id            String          @id @default(uuid())
  timeTableCode String          @unique
  className     String
  section       String
  subjectName   String
  teacherName   String
  roomNo        String
  day           RoutineDay
  startTime     String
  endTime       String
  status        TimeTableStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("time_tables")
}
