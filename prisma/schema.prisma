generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)

  // Auth email flows
  twoStepEnabled Boolean @default(false)
  emailVerified  Boolean @default(false)

  passwordResetTokens PasswordResetToken[]
  loginOtps           LoginOtp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginOtp {
  id        String    @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_otps")
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
}

model Student {
  id            String        @id @default(uuid())
  admissionNo   String        @unique
  firstName     String
  lastName      String
  email         String?       @unique
  phone         String?
  gender        StudentGender
  dateOfBirth   DateTime?
  className     String
  section       String?
  guardianName  String
  guardianPhone String
  address       String?
  status        StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("students")
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum ParentStatus {
  ACTIVE
  INACTIVE
}

model Parent {
  id         String         @id @default(uuid())
  fullName   String
  email      String?        @unique
  phone      String
  relation   ParentRelation
  occupation String?
  address    String?
  status     ParentStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parents")
}

enum GuardianRelation {
  UNCLE
  AUNT
  GRANDFATHER
  GRANDMOTHER
  BROTHER
  SISTER
  OTHER
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

model Guardian {
  id         String           @id @default(uuid())
  fullName   String
  email      String?          @unique
  phone      String
  relation   GuardianRelation
  occupation String?
  address    String?
  status     GuardianStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guardians")
}

enum TeacherGender {
  MALE
  FEMALE
  OTHER
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

model Teacher {
  id            String        @id @default(uuid())
  employeeNo    String        @unique
  fullName      String
  email         String        @unique
  phone         String
  gender        TeacherGender
  subject       String
  qualification String?
  joiningDate   DateTime
  address       String?
  status        TeacherStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teachers")
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

model Department {
  id               String           @id @default(uuid())
  departmentCode   String           @unique
  departmentName   String
  headOfDepartment String?
  phone            String?
  email            String?
  location         String?
  description      String?
  status           DepartmentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("departments")
}

enum DesignationStatus {
  ACTIVE
  INACTIVE
}

model Designation {
  id              String            @id @default(uuid())
  designationCode String            @unique
  designationName String
  departmentCode  String?
  departmentName  String?
  description     String?
  status          DesignationStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("designations")
}

enum StaffGender {
  MALE
  FEMALE
  OTHER
}

enum StaffEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

model Staff {
  id              String              @id @default(uuid())
  staffCode       String              @unique
  fullName        String
  email           String              @unique
  phone           String
  gender          StaffGender
  departmentCode  String?
  departmentName  String
  designationCode String?
  designation     String
  employmentType  StaffEmploymentType @default(FULL_TIME)
  joiningDate     DateTime
  salary          Float?
  address         String?
  status          StaffStatus         @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("staffs")
}

enum HolidayType {
  PUBLIC
  SCHOOL
  EVENT
  OTHER
}

enum HolidayStatus {
  ACTIVE
  INACTIVE
}

model Holiday {
  id          String        @id @default(uuid())
  holidayCode String        @unique
  title       String
  startDate   DateTime
  endDate     DateTime
  holidayType HolidayType   @default(PUBLIC)
  description String?
  status      HolidayStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("holidays")
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  MATERNITY
  EMERGENCY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model StaffLeave {
  id              String      @id @default(uuid())
  leaveCode       String      @unique
  staffCode       String?
  staffName       String
  departmentCode  String?
  departmentName  String?
  designationCode String?
  designation     String?
  leaveType       LeaveType
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedBy      String?
  remarks         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("staff_leaves")
}

enum StaffAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model StaffAttendance {
  id             String                @id @default(uuid())
  staffId        String?
  staffCode      String
  staffName      String
  department     String?
  designation    String?
  attendanceDate DateTime
  status         StaffAttendanceStatus @default(PRESENT)
  remarks        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_attendance")
}

enum StudentAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model StudentAttendance {
  id                 String                  @id @default(uuid())
  attendanceCode     String                  @unique
  studentAdmissionNo String?
  studentName        String
  className          String
  section            String?
  attendanceDate     DateTime
  status             StudentAttendanceStatus @default(PRESENT)
  checkInTime        String?
  checkOutTime       String?
  remarks            String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([studentAdmissionNo, attendanceDate])
  @@map("student_attendance")
}

enum TeacherAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model TeacherAttendance {
  id                String                  @id @default(uuid())
  attendanceCode    String                  @unique
  teacherEmployeeNo String?
  teacherName       String
  subject           String?
  attendanceDate    DateTime
  status            TeacherAttendanceStatus @default(PRESENT)
  checkInTime       String?
  checkOutTime      String?
  remarks           String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([teacherEmployeeNo, attendanceDate])
  @@map("teacher_attendance")
}

enum PayrollStatus {
  PENDING
  PAID
  FAILED
}

model Payroll {
  id          String        @id @default(uuid())
  payrollCode String        @unique
  staffCode   String?
  staffName   String
  department  String?
  designation String?
  salaryMonth String
  basicSalary Float         @default(0)
  allowance   Float         @default(0)
  deduction   Float         @default(0)
  netSalary   Float         @default(0)
  status      PayrollStatus @default(PENDING)
  paymentDate DateTime?
  remarks     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([staffCode, salaryMonth])
  @@map("payrolls")
}

enum FeeType {
  ADMISSION
  TUITION
  EXAM
  LIBRARY
  TRANSPORT
  ACTIVITY
  OTHER
}

enum FeePaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum FeePaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  CHEQUE
}

model Fee {
  id                 String            @id @default(uuid())
  receiptNo          String            @unique
  feeGroupCode       String?
  feeGroupName       String?
  studentAdmissionNo String?
  studentName        String
  className          String
  section            String?
  feeType            FeeType
  amount             Float
  paidAmount         Float             @default(0)
  balance            Float
  dueDate            DateTime?
  paidDate           DateTime?
  paymentStatus      FeePaymentStatus  @default(PENDING)
  paymentMethod      FeePaymentMethod?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@map("fees")
}

enum FeeGroupStatus {
  ACTIVE
  INACTIVE
}

model FeeGroup {
  id           String         @id @default(uuid())
  feeGroupCode String         @unique
  feeGroupName String
  className    String?
  section      String?
  feeType      FeeType
  amount       Float
  dueDays      Int?
  description  String?
  status       FeeGroupStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("fee_groups")
}

enum LibraryMemberType {
  STUDENT
  TEACHER
  STAFF
}

enum LibraryMemberStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model LibraryMember {
  id            String              @id @default(uuid())
  memberCode    String              @unique
  memberType    LibraryMemberType
  referenceCode String?
  memberName    String
  className     String?
  department    String?
  phone         String?
  email         String?
  joinDate      DateTime
  status        LibraryMemberStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([memberType, referenceCode])
  @@map("library_members")
}

enum LibraryBookStatus {
  AVAILABLE
  UNAVAILABLE
}

model LibraryBook {
  id              String            @id @default(uuid())
  bookCode        String            @unique
  bookTitle       String
  isbn            String?           @unique
  author          String
  category        String
  publisher       String?
  totalCopies     Int               @default(1)
  availableCopies Int               @default(1)
  shelfNo         String?
  status          LibraryBookStatus @default(AVAILABLE)
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("library_books")
}

enum TransportRouteStatus {
  ACTIVE
  INACTIVE
}

model TransportRoute {
  id            String               @id @default(uuid())
  routeCode     String               @unique
  routeName     String
  startLocation String
  endLocation   String
  stops         Json?
  routePoints   Json?
  distanceKm    Float?
  estimatedTime String?
  vehicleNo     String?
  driverName    String?
  status        TransportRouteStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@map("transport_routes")
}

enum HostelType {
  BOYS
  GIRLS
  MIXED
}

enum HostelStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model Hostel {
  id            String       @id @default(uuid())
  hostelCode    String       @unique
  hostelName    String
  hostelType    HostelType
  wardenName    String?
  phone         String?
  address       String?
  totalRooms    Int          @default(1)
  totalBeds     Int          @default(1)
  availableBeds Int          @default(1)
  monthlyFee    Float?
  status        HostelStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("hostels")
}

enum SportStatus {
  ACTIVE
  INACTIVE
}

model Sport {
  id                  String      @id @default(uuid())
  sportCode           String      @unique
  sportName           String
  category            String?
  coachName           String?
  venue               String?
  practiceDays        String?
  practiceTime        String?
  maxParticipants     Int         @default(0)
  currentParticipants Int         @default(0)
  status              SportStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("sports")
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

model SchoolClass {
  id           String      @id @default(uuid())
  className    String
  section      String
  classTeacher String?
  roomNo       String?
  capacity     Int?
  status       ClassStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([className, section])
  @@map("classes")
}

enum ClassRoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

model ClassRoom {
  id       String          @id @default(uuid())
  roomNo   String          @unique
  roomName String
  building String?
  floor    String?
  capacity Int?
  status   ClassRoomStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("class_rooms")
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

model Subject {
  id          String        @id @default(uuid())
  subjectCode String        @unique
  subjectName String
  className   String?
  teacherName String?
  weeklyHours Int?
  status      SubjectStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

enum ClassRoutineStatus {
  ACTIVE
  INACTIVE
}

enum RoutineDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ClassRoutine {
  id          String             @id @default(uuid())
  routineCode String             @unique
  className   String
  section     String
  subjectName String
  teacherName String
  roomNo      String
  day         RoutineDay
  startTime   String
  endTime     String
  status      ClassRoutineStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("class_routines")
}

enum ExamStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Exam {
  id          String     @id @default(uuid())
  examCode    String     @unique
  examName    String
  className   String
  section     String
  subjectName String
  teacherName String
  roomNo      String
  examDate    DateTime
  startTime   String
  endTime     String
  maxMarks    Int
  minMarks    Int
  status      ExamStatus @default(SCHEDULED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("exams")
}

enum GradeResult {
  PASS
  FAIL
}

enum GradeStatus {
  DRAFT
  PUBLISHED
}

model Grade {
  id            String      @id @default(uuid())
  gradeCode     String      @unique
  examCode      String
  examName      String
  className     String
  section       String
  subjectName   String
  teacherName   String
  admissionNo   String
  studentName   String
  marksObtained Int
  maxMarks      Int
  minMarks      Int
  result        GradeResult
  gradeLetter   String
  status        GradeStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([examCode, admissionNo])
  @@map("grades")
}

enum SyllabusSubjectGroupStatus {
  ACTIVE
  INACTIVE
}

model SyllabusSubjectGroup {
  id            String                     @id @default(uuid())
  groupCode     String                     @unique
  groupName     String
  className     String
  section       String
  classTeacher  String?
  subjectNames  String[]
  subjectCodes  String[]                   @default([])
  totalSubjects Int                        @default(0)
  status        SyllabusSubjectGroupStatus @default(ACTIVE)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@map("syllabus_subject_groups")
}

enum TimeTableStatus {
  ACTIVE
  INACTIVE
}

model TimeTable {
  id            String          @id @default(uuid())
  timeTableCode String          @unique
  className     String
  section       String
  subjectName   String
  teacherName   String
  roomNo        String
  day           RoutineDay
  startTime     String
  endTime       String
  status        TimeTableStatus @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("time_tables")
}

enum SchoolEventType {
  MEETING
  HOLIDAY_EVENT
  EXAM_EVENT
  SPORTS_EVENT
  GENERAL
}

enum SchoolEventAudience {
  ALL
  STUDENTS
  TEACHERS
  STAFF
  PARENTS
}

enum SchoolEventStatus {
  ACTIVE
  INACTIVE
}

model SchoolEvent {
  id          String              @id @default(uuid())
  title       String
  eventType   SchoolEventType     @default(GENERAL)
  audience    SchoolEventAudience @default(ALL)
  startDate   DateTime
  endDate     DateTime?
  startTime   String?
  endTime     String?
  location    String?
  organizer   String?
  description String?
  status      SchoolEventStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("school_events")
}
