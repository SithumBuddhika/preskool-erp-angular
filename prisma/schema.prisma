generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
}

model Student {
  id            String        @id @default(uuid())
  admissionNo   String        @unique
  firstName     String
  lastName      String
  email         String?       @unique
  phone         String?
  gender        StudentGender
  dateOfBirth   DateTime?
  className     String
  section       String?
  guardianName  String
  guardianPhone String
  address       String?
  status        StudentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("students")
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum ParentStatus {
  ACTIVE
  INACTIVE
}

model Parent {
  id         String         @id @default(uuid())
  fullName   String
  email      String?        @unique
  phone      String
  relation   ParentRelation
  occupation String?
  address    String?
  status     ParentStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parents")
}

enum GuardianRelation {
  UNCLE
  AUNT
  GRANDFATHER
  GRANDMOTHER
  BROTHER
  SISTER
  OTHER
}

enum GuardianStatus {
  ACTIVE
  INACTIVE
}

model Guardian {
  id         String           @id @default(uuid())
  fullName   String
  email      String?          @unique
  phone      String
  relation   GuardianRelation
  occupation String?
  address    String?
  status     GuardianStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guardians")
}

enum TeacherGender {
  MALE
  FEMALE
  OTHER
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

model Teacher {
  id            String        @id @default(uuid())
  employeeNo    String        @unique
  fullName      String
  email         String        @unique
  phone         String
  gender        TeacherGender
  subject       String
  qualification String?
  joiningDate   DateTime
  address       String?
  status        TeacherStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teachers")
}

enum ClassStatus {
  ACTIVE
  INACTIVE
}

model SchoolClass {
  id           String      @id @default(uuid())
  className    String
  section      String
  classTeacher String?
  roomNo       String?
  capacity     Int?
  status       ClassStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([className, section])
  @@map("classes")
}
